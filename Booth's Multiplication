def twos_complement(val,bits):
    if val<0:
        val = (1<<bits)+val;
    return val & ((1<<bits)-1)

def booth(m,q,n):
    m=twos_complement(m,n)
    q=twos_complement(q,n)
    a=0
    q_1=0

    for i in range(n):
        q0=q&1
        if q0==0 and q_1==1:
            a=(a+m)&((1<<n)-1)
        elif q0==1 and q_1==0:
            a=(a-m)&((1<<n)-1)

        combined=(a<<(n+1)) | (q<<1) | q_1
        sign = (combined>>(2*n))&1

        combined >>=1
        if sign:
            combined |=(1<<(2*n))

        a=(combined>> (n+1)) & ((1<<n)-1)
        q=(combined>>1)& ((1<<n)-1)
        q_1=combined&1

        result = (a<<n)|q

        if result &(1<<(2*n-1)):
            result -= (1<<(2*n))
    return result
print(booth(3,-4,4))
    
    
